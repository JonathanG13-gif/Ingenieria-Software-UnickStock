flowchart TD
    web[App web]
    subgraph srv[Servidor UnikStock]
        cat[Catálogo<br/>productos, variantes y búsqueda]
        inv[Inventario<br/>stock, entradas, mínimos y agotados]
        ven[Ventas<br/>ventas, devoluciones e historial]
    end
    db[(Base de datos)]

    web --> cat
    web --> inv
    web --> ven
    ven -->|busca el producto| cat
    ven -->|pide descontar o reintegrar stock| inv
    inv -->|consulta la variante| cat
    cat --> db
    inv --> db
    ven --> db

    style ven fill:#ff5d00,color:#fff

flowchart TD
    dueno([Dueño o administrador])
    vend([Vendedor de mostrador])
    subgraph sistema[UnikStock]
        web[App web<br/>navegador en celular o computadora]
        srv[Servidor UnikStock<br/>monolito modular, Node.js]
        db[(Base de datos<br/>PostgreSQL)]
    end

    dueno -->|usa| web
    vend -->|usa| web
    web -->|HTTPS/JSON| srv
    srv -->|lee y escribe| db

    style srv fill:#ff5d00,color:#fff
